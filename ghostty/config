font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13

theme = dark:Ayu Dark,light:Ayu Light
background = #0c0c0c
background-opacity = 1.0

title = "Ghostty"
window-subtitle = false
window-theme = ghostty
window-padding-x = 4
window-padding-y = 0
window-padding-balance = true
window-padding-color = extend-always
window-height = 32
window-width = 128

quick-terminal-position = center
mouse-hide-while-typing = true

# Keybinds ----------------------------------------------------------
# keybind = ctrl+l=clear_screen
keybind = ctrl+t=toggle_window_decorations
# keybind = ctrl+w=close_tab:this
keybind = ctrl+shift+w=close_surface
# Split navigation
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down

# Palette -----------------------------------------------------------
# Owner color
palette = 230=#F3BE7C
# Group color
palette = 187=#ED9F40
# Size color
palette = 229=#BB9DBD

shell-integration-features = ssh-env, ssh-terminfo
